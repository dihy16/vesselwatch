OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: OpenAI-compatible API root, for example http://localhost:8000/v1
OPENAI_BASE_URL=

# Optional: vision-capable model/endpoint for review_ship_images.
# Empty values fall back to the corresponding OPENAI_* setting above.
OPENAI_VISION_MODEL=
OPENAI_VISION_BASE_URL=
OPENAI_VISION_API_KEY=

# Optional: public image URL when using langgraph.demo.json on a remote machine.
# VESSELWATCH_DEMO_PUBLIC_URL=http://127.0.0.1:8002
# VESSELWATCH_DEMO_DIR=data/demo
# Optional: server URL used by the map tool (different from the browser's public URL).
# VESSELWATCH_DEMO_API_URL=http://127.0.0.1:8002
# Optional: persistent map snapshots. Export for the demo server, which does not load .env.
# VESSELWATCH_DEMO_MAP_DIR=data/demo/maps
